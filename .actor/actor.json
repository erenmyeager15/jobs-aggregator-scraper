{
    "actorSpecification": 1,
    "name": "jobs-aggregator-scraper",
    "title": "Jobs Aggregator Scraper: Remote Job APIs",
    "description": "Aggregate public remote job listings from Remote OK, Remotive, and Arbeitnow into one clean dataset with titles, companies, locations, salaries, URLs, and source attribution.",
    "version": "1.0",
    "buildTag": "latest",
    "categories": ["JOBS", "RESEARCH", "AUTOMATION"],
    "dockerfile": "Dockerfile",
    "input": "../INPUT_SCHEMA.json",
    "readme": "../README.md",
    "output": "./output_schema.json",
    "exampleRunInput": {
        "body": "{\"source\":\"all\",\"keywords\":[\"software\"],\"location\":\"\",\"remoteOnly\":true,\"dateFrom\":\"\",\"maxResults\":1,\"maxPagesPerSource\":1,\"includeDescription\":false}",
        "contentType": "application/json; charset=utf-8"
    },
    "storages": {
        "dataset": "./dataset_schema.json"
    },
    "pricingInfo": {
        "pricingModel": "PAY_PER_EVENT",
        "pricingPerEvent": {
            "actorChargeEvents": {
                "apify-actor-start": {
                    "eventTitle": "Actor Start",
                    "eventDescription": "Charged when the Actor starts running. Number of events charged depends on Actor memory (one event per GB, minimum one event).",
                    "eventPriceUsd": 0.00005,
                    "isPrimaryEvent": false,
                    "isOneTimeEvent": true
                },
                "job-scraped": {
                    "eventTitle": "Job scraped",
                    "eventDescription": "Charged once for each clean job record saved to the dataset.",
                    "eventPriceUsd": 0.002,
                    "isPrimaryEvent": true,
                    "isOneTimeEvent": false
                }
            }
        }
    },
    "defaultRunOptions": {
        "build": "latest",
        "memoryMbytes": 512,
        "timeoutSecs": 900
    },
    "minMemoryMbytes": 512,
    "maxMemoryMbytes": 1024,
    "webScraper": false
}
